// adds numbers and prints the result.
global proc float addition( float $input[])
{
    float $sum = 0.0;
    int $size = size($input);
    for ($i = 0; $i < $size; $i++)
     {
    $sum += $input[$i];
     }
    return $sum;
}


// subtracts numbers and prints the result.
global proc float subtraction(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided.\n");
        return 0;
    }

    float $dif = $input[0];
    for ($i = 1; $i < $size; $i++)
    {
        $dif -= $input[$i];
    }
    return $dif;
}

// multiplies two numbers and prints the result.
global proc float multiplication(float $input[])
{
    float $prod = 1;
    int $size = size($input);
    for ($i = 0; $i < $size; $i++)
     {
    $prod *= $input[$i];
     }
    return $prod;
}


// divides two numbers and prints the result.
global proc float division(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided.\n");
        return 0;
    }

    float $quo = $input[0];

    for ($i = 1; $i < $size; $i++)
    {
        if ($input[$i] == 0)
        {
            print("Error: Division by zero is not allowed.\n");
            return 0;
        }
        $quo /= $input[$i];
    }

    return $quo;
}


// finds the median and prints the result.
global proc float median(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided for median.\n");
        return 0;
    }

    float $sorted[] = `sort $input`;

    float $med;

    if ($size % 2 == 0)
    {
        // Even number of elements: average of two middle values
        $med = ($sorted[$size/2] + $sorted[($size/2)-1]) / 2.0;
    }
    else
    {
        // Odd number of elements: return middle value
        $med = $sorted[$size/2];
    }

    return $med;
}



// finds the average and prints the result.
global proc float average(float $input[])
{
    float $sum = 0.0;
    int $size = size($input);
    if ($size == 0) {
    print("Error: No input provided for average.\n");
    return 0;
}
    for ($i = 0; $i < $size; $i++)
     {
    $sum += $input[$i];
     }
    float $average = $sum / $size;
    return $average;
}

// raises num1 to the power of num2 and prints the result.
global proc float power(float $input[])
{
    if (size($input) < 2)
    {
        print("Error: At least two numbers are required for the power operation.\n");
        return 0;
    }
    else
    {
      float $result = `pow $input[0] $input[1]`;
        return $result;
    }
    
}



// main execution
global proc float calculate(float $userinput[], int $operation)
{
    string $opName = "";
    float $result = 0;
    if ($operation == 1)
    {
        $result = addition($userinput);
        $opName = "+";
    }
    else if ($operation == 2)
    {
        $result = subtraction($userinput);
        $opName = "-";
    }
    else if ($operation == 3)
    {
        $result = multiplication($userinput);
        $opName = "*";
    }
    else if ($operation == 4)
    {
        $result = division($userinput);
        $opName = "/";
    }
    else if ($operation == 5)
    {
        $result = median($userinput);
        $opName = "median";
    }
    else if ($operation == 6)
    {
        $result = average($userinput);
        $opName = "average";
    }
    else if ($operation == 7)
    {
        $result = power($userinput);
        $opName = "^";
    }
    else
    {
        print("Invalid operation selected.\n");
        return 0;
    }

    // Format input numbers as a string
    string $inputStr = "";
    for ($i = 0; $i < size($userinput); $i++) {
        $inputStr += $userinput[$i];
        if ($i < size($userinput)-1) $inputStr += ", ";
    }

    // Print the operation performed
    if ($opName == "median" || $opName == "average") {
        print ("Inputs: [" + $inputStr + "] | Operation: " + $opName + " | Result: " + $result + "\n");
    } else if ($opName == "^") {
        print ("Inputs: [" + $inputStr + "] | Operation: power | Result: " + $result + "\n");
    } else {
        print ("Inputs: [" + $inputStr + "] | Operation: " + $opName + " | Result: " + $result + "\n");
    }
    // return the numeric result so callers can use it programmatically
    return $result;
}
// Example: calculate({10, 5, 3}, 1);

// -----------------------------
// UI: Calculator Window
// -----------------------------
// Creates a standalone UI to collect input array and operation, and display result.
global proc calculatorUI()
{
    string $win = "CalculatorWin";
    if (`window -exists $win`) deleteUI $win;

    window -title "MEL Calculator" -widthHeight 420 160 $win;
    columnLayout -adjustableColumn true;

    // Input: numbers as comma-separated list
    text -label "Enter numbers (comma-separated):";
    // use fixed control name so other code can reference it predictably
    string $inputField = "calcInputField";
    textField -text "" -w 400 -placeholderText "e.g. 10, 5, 3" -ann "Numbers input" $inputField;

    // Operation menu
    text -label "Operation:";
    // fixed name for predictable lookups
    string $opMenu = "calcOpMenu";
    optionMenu -changeCommand "" $opMenu;
    menuItem -label "Addition (+)";
    menuItem -label "Subtraction (-)";
    menuItem -label "Multiplication (*)";
    menuItem -label "Division (/)";
    menuItem -label "Median";
    menuItem -label "Average";
    menuItem -label "Power (a^b)";

    // Result display
    text -label "Result:";
    // fixed name for result control
    string $resultField = "calcResultField";
    textField -text "" -w 400 -enable false $resultField;

    // Buttons row
    rowLayout -numberOfColumns 3 -columnWidth3 140 140 140 -adjustableColumn 2;
    button -label "Calculate" -command ("calculatorUICalc \"" + $inputField + "\" \"" + $opMenu + "\" \"" + $resultField + "\"");
    button -label "Clear" -command ("textField -e -text \"\" " + $inputField);
    button -label "Close" -command ("deleteUI " + $win);
    setParent ..;

    showWindow $win;
}

// Helper: open the calculator UI, populate example inputs, and run a sample calculation
global proc calculatorUI_withExample()
{
    // create the UI
    calculatorUI();

    // small delay to ensure UI widgets exist in some Maya builds (safe no-op elsewhere)
    // try to set example values
    string $example = "10, 5, 3";
    // fill the input field
    if (`textField -ex "calcInputField"`) textField -e -text $example "calcInputField";
    else print ("Warning: input control not found.\n");

    // set operation to Addition
    if (`optionMenu -ex "calcOpMenu"`) optionMenu -e -value "Addition (+)" "calcOpMenu";

    // trigger the calculation callback so result is shown
    if (`textField -ex "calcResultField"`) calculatorUICalc("calcInputField", "calcOpMenu", "calcResultField");
}

// Auto-launch the calculator UI with example when this script is sourced
// Some users may prefer to call calculatorUI() manually; keep this behavior simple to opt-out by commenting the call below.
calculatorUI_withExample();

// Helper: parse a comma separated string into a float array
global proc float[] calculator_parseInput(string $str)
{
    // remove spaces
    string $trim = `substituteAllString $str " " ""`;
    if (size($trim) == 0 || $trim == "") { float $empty[] = {}; return $empty; }

    // Use a local split implementation because some Maya builds don't provide `split` in MEL
    string $tokens[] = mel_split($trim, ",");
    int $n = size($tokens);
    float $out[];
    for ($i = 0; $i < $n; $i++)
    {
        // ignore empty tokens
        if ($tokens[$i] == "") continue;
        float $val = 0;
        // attempt to convert token to float; MEL will coerce numeric strings
        $val = (float)$tokens[$i];
        $out[size($out)] = $val;
    }
    return $out;
}


// Small, portable split implementation: splits $str by $delim and returns a string array
global proc string[] mel_split(string $str, string $delim)
{
    string $out[];
    if ($str == "") return $out;

    int $len = size($str);
    int $dlen = size($delim);
    string $cur = "";
    int $i;

    for ($i = 1; $i <= $len; $i++)
    {
        string $ch = `substring $str $i $i`;
        if ($dlen == 1)
        {
            if ($ch == $delim)
            {
                $out[size($out)] = $cur;
                $cur = "";
            }
            else
            {
                $cur += $ch;
            }
        }
        else
        {
            // handle multi-character delimiter
            if ($i + $dlen - 1 <= $len)
            {
                string $seg = `substring $str $i ($i + $dlen - 1)`;
                if ($seg == $delim)
                {
                    $out[size($out)] = $cur;
                    $cur = "";
                    $i = $i + $dlen - 1; // advance past delimiter
                    continue;
                }
            }
            $cur += $ch;
        }
    }

    // add remaining segment
    $out[size($out)] = $cur;
    return $out;
}

// Callback invoked by the UI Calculate button
global proc calculatorUICalc(string $inputFieldName, string $opMenuName, string $resultFieldName)
{
    // read values from controls
    string $inputText = `textField -q -text $inputFieldName`;
    string $opSelection = `optionMenu -q -value $opMenuName`;

    float $nums[] = calculator_parseInput($inputText);

    // map menu label to operation index used by calculate()
    int $op = 0;
    if ($opSelection == "Addition (+)") $op = 1;
    else if ($opSelection == "Subtraction (-)") $op = 2;
    else if ($opSelection == "Multiplication (*)") $op = 3;
    else if ($opSelection == "Division (/)") $op = 4;
    else if ($opSelection == "Median") $op = 5;
    else if ($opSelection == "Average") $op = 6;
    else if ($opSelection == "Power (a^b)") $op = 7;

    float $result = 0;
    string $resultStr = "";

    // Basic validations
    if ($op == 0)
    {
        $resultStr = "Error: Invalid operation.";
    }
    else if (size($nums) == 0)
    {
        $resultStr = "Error: No numeric input.";
    }
    else
    {
        if ($op == 7 && size($nums) < 2)
        {
            $resultStr = "Error: Power requires two numbers (a,b).";
        }
        else
        {
            $result = calculate($nums, $op);
            $resultStr = "" + $result;
        }
    }

    // update result textField (enable temporarily to set text)
    // Try setting text without toggling enable first (works in most builds)
    textField -e -text $resultStr $resultFieldName;
    // Also set with enable toggle in case some builds require it
    textField -e -enable true -text $resultStr $resultFieldName;
    textField -e -enable false $resultFieldName;
}

