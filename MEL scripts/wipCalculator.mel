
// adds two numbers and prints the result.
global proc addition(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $sum = $a + $b;
    print("The sum of " + $a + " and " + $b + " is: " + $sum + "\n");
    
}

// subtracts two numbers and prints the result.
global proc subtraction(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $difference = $a - $b;
    print("The difference between " + $a + " and " + $b + " is: " + $difference + "\n");
    
}

// multiplies two numbers and prints the result.
global proc multiplication(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $product = $a * $b;
    print("The product of " + $a + " and " + $b + " is: " + $product + "\n");
    
}


// divides two numbers and prints the result.
global proc division(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    if ($b != 0)
    {
        float $quotient = $a / $b;
        print("The quotient of " + $a + " divided by " + $b + " is: " + $quotient + "\n");
    }
    else
    {
        print("Error: Division by zero is not allowed.\n");
    }
    
}

// finds the median of two numbers and prints the result.
global proc median(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $median = ($a + $b) / 2;
    print("The median of " + $a + " and " + $b + " is: " + $median + "\n");
    
}

// finds the average of two numbers and prints the result.
global proc average(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $average = ($a + $b) / 2;
    print("The average of " + $a + " and " + $b + " is: " + $average + "\n");
    
}

// raises num1 to the power of num2 and prints the result.
global proc power(float $num1, float $num2)
{
    float $a = $num1;
    float $b = $num2;
    float $result = `pow $a $b`;
    print($a + " raised to the power of " + $b + " is: " + $result + "\n");
    
}


// main execution
global proc main(float $num1, float $num2, int $operation)
{
    if ($operation == 1)
    {
        addition($num1, $num2);
    }
    else if ($operation == 2)
    {
        subtraction($num1, $num2);
    }
    else if ($operation == 3)
    {
        multiplication($num1, $num2);
    }
    else if ($operation == 4)
    {
        division($num1, $num2);
    }
    else if ($operation == 5)
    {
        median($num1, $num2);
    }
    else if ($operation == 6)
    {
        average($num1, $num2);
    }
    else if {$operation == 7}
    {
        power($num1, $num2);
    }
    else
    {
        print("Invalid operation selected.\n");
    }

   
}
main(10, 5, 3); // Example 