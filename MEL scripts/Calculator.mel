
// adds numbers and prints the result.
global proc float addition( float $input[])
{
    float $sum = 0.0;
    int $size = size($input);
    for ($i = 0; $i < $size; $i++)
     {
    $sum += $input[$i];
     }
    print ("Total sum: " + $sum + "\n");
    return $sum;
}

// subtracts numbers and prints the result.
global proc float subtraction(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided.\n");
        return 0;
    }

    float $dif = $input[0];
    for ($i = 1; $i < $size; $i++)
    {
        $dif -= $input[$i];
    }
    print("Difference: " + $dif + "\n");
    return $dif;
}

// multiplies two numbers and prints the result.
global proc float multiplication(float $input[])
{
    float $prod = 1;
    int $size = size($input);
    for ($i = 0; $i < $size; $i++)
     {
    $prod *= $input[$i];
     }
    print ("product: " + $prod + "\n");
    return $prod;
}


// divides two numbers and prints the result.
global proc float division(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided.\n");
        return 0;
    }

    float $quo = $input[0];

    for ($i = 1; $i < $size; $i++)
    {
        if ($input[$i] == 0)
        {
            print("Error: Division by zero is not allowed.\n");
            return 0;
        }
        $quo /= $input[$i];
    }

    print("Quotient: " + $quo + "\n");
    return $quo;
}


// finds the median and prints the result.
global proc float median(float $input[])
{
    int $size = size($input);
    if ($size == 0) {
        print("Error: No input provided for median.\n");
        return 0;
    }

    float $sorted[] = `sort $input`;

    float $med;

    if ($size % 2 == 0)
    {
        // Even number of elements: average of two middle values
        $med = ($sorted[$size/2] + $sorted[($size/2)-1]) / 2.0;
    }
    else
    {
        // Odd number of elements: return middle value
        $med = $sorted[$size/2];
    }

    print("Median: " + $med + "\n");
    return $med;
}



// finds the average and prints the result.
global proc float average(float $input[])
{
    float $sum = 0.0;
    int $size = size($input);
    if ($size == 0) {
    print("Error: No input provided for average.\n");
    return 0;
}
    for ($i = 0; $i < $size; $i++)
     {
    $sum += $input[$i];
     }
    float $average = $sum / $size;
    print("The average is: " + $average + "\n");
    return $average;
}

// raises num1 to the power of num2 and prints the result.
global proc float power(float $input[])
{
    if (size($input) < 2)
    {
        print("Error: At least two numbers are required for the power operation.\n");
        return 0;
    }
    else
    {
      float $result = `pow $input[0] $input[1]`;
        print($input[0] + " raised to the power of " + $input[1] + " is: " + $result + "\n");  
        return $result;
    }
    
}



// main execution
global proc calculate(float $userinput[], int $operation)
{
    if ($operation == 1)
    {
        addition($userinput);
    }
    else if ($operation == 2)
    {
        subtraction($userinput);
    }
    else if ($operation == 3)
    {
        multiplication($userinput);
    }
    else if ($operation == 4)
    {
        division($userinput);
    }
    else if ($operation == 5)
    {
        median($userinput);
    }
    else if ($operation == 6)
    {
        average($userinput);
    }
    else if ($operation == 7)
    {
        power($userinput);
    }
    else
    {
        print("Invalid operation selected.\n");
    }

   
}
// Example: calculate({10, 5, 3}, 1); 
 